/dts-v1/;
/plugin/;

/*
 * Radxa Zero 2 Pro (Amlogic A311D) + Radxa 4K Camera (IMX415) overlay.
 *
 * Ties together, in one compile+apply unit (avoids needing cross-overlay
 * __symbols__/__fixups__ ordering):
 *   fragment@0: isp_clkc  - the auxiliary clock provider (isp_clkc.ko)
 *               registering the 7 ISP/CSI/gen_clk clocks this kernel's
 *               built-in amlogic,g12b-clkc driver doesn't have. See
 *               isp_clkc.c / PORT_NOTES.md in build-clk/.
 *   fragment@1: isp@ff140000 / isp-adapter@ff650000 / phy-csi@ff650000 -
 *               the vendor ISP/CSI2-PHY hardware nodes (iv009_isp.ko),
 *               register layout from mesong12b.dtsi (khadas-vims-4.9.y),
 *               clocks repointed at &isp_clkc instead of the vendor's
 *               &clkc (which doesn't have them on this kernel).
 *   fragment@2: the imx415 i2c child node under i2c3 (already enabled and
 *               live as /dev/i2c-3 on this board - confirmed via the
 *               official schematic, see below).
 *   fragment@3: three always-on regulator-fixed stand-ins for imx415's
 *               dvdd/ovdd/avdd supplies.
 *
 * Hardware facts below are from Radxa's official
 * radxa_zero_2_pro_v1.2_schematic.pdf (pages 6 "GPIO", 9 "CPU I/O" and 13
 * "Panel/CAM/40PIN"), cross-checked against the live board:
 *   - CSI connector (J5002, 31-pin 0.3mm FPC) MIPI_CSI_D0..D3 + CLKA data/
 *     clock lanes wire straight to the A311D's own CSI PHY pins - these
 *     are silicon-fixed, nothing to configure in DT beyond the phy-csi
 *     node itself (already vendor-defined, unchanged).
 *   - CM_MCLK (J5002 pin 21, "CAM0-CLK") is ball AU36 = GPIOAO_10, and the
 *     function it needs is the SoC's CLK12_24 output.
 *
 *     This is NOT gen_clk. gen_clk (GEN_CLK_EE/GEN_CLK_AO) comes out on
 *     GPIOAO_11 (ball BF16), which this board routes to the *panel*
 *     connector - it is not connected to the camera at all. An earlier
 *     revision of this overlay clocked the sensor from gen_clk on the
 *     assumption that GPIOAO_10's CLK12_24 "was" gen_clk; it can never
 *     have worked.
 *
 *     Mainline's pinctrl-meson-g12a.c has no group for CLK12_24 (on
 *     GPIOAO_10 it models only cec_ao_a=1, cec_ao_b=2, tdm_ao_b_din1=6),
 *     so this cannot be selected with pinctrl-0 from DT. The ao_mclk
 *     module pokes the mux field directly instead; see ao-mclk/ao_mclk.c.
 *     Verified on hardware: with no MCLK the sensor does not ACK at 0x1a
 *     for ANY combination of the reset/power-down/frame-sync GPIOs.
 *   - CM_I2C_SCL/CM_I2C_SDA (connector pins 25/26) are the *same net* as
 *     the 40-pin header's I2C pins 3/5 -> i2c3
 *     (/soc/bus@ffd00000/i2c@1c000), already status=okay by default.
 *     Confirmed live: /dev/i2c-3 maps to ffd1c000.i2c, and its only other
 *     occupant is fusb302 (USB-C PD) at 0x22 - no clash with the sensor's
 *     0x1a. No i2c-enable overlay needed.
 *   - Camera control GPIOs, from schematic page 6 (these were previously
 *     unknown and are now pinned down):
 *         CM_RST_L    -> GPIOA_11 (ball G22) -> &gpio line 60, active low
 *         CM_PWRDN_1  -> GPIOA_10 (ball G25) -> &gpio line 59
 *         CM_FS       -> GPIOA_6  (ball E15) -> &gpio line 55
 *     Only reset is wired up below; empirically the sensor enumerates on
 *     i2c with PWRDN/FS left alone, so they are deliberately not driven.
 *   - The connector takes fixed VCC3.3V/VCC5V with no software power gate,
 *     which is why the regulators in fragment@3 are always-on stand-ins.
 */

/ {
	fragment@0 {
		target-path = "/soc/bus@ff600000/bus@3c000/system-controller@0";

		__overlay__ {
			isp_clkc: isp-clkc {
				compatible = "radxa,zero2pro-isp-clkc";
				#clock-cells = <1>;
				status = "okay";
			};
		};
	};

	fragment@1 {
		target-path = "/";

		__overlay__ {
			isp: isp@ff140000 {
				compatible = "arm, isp";
				reg = <0x0 0xff140000 0x0 0x00040000>;
				reg-names = "ISP";
				isp-efuse = <0xff630038 0x4000>;
				interrupts = <0 142 4>;
				interrupt-names = "ISP";
				temper-buf-size = <24>;
				clocks = <&isp_clkc 0>, <&isp_clkc 1>;
				clock-names = "cts_mipi_isp_clk_composite",
					      "cts_mipi_csi_phy_clk0_composite";
				/* Points at the SCALER, not the adapter -
				 * matches mesong12b.dtsi's isp node
				 * (`link-device = <&isp_sc>`). Pointing this
				 * at &adapter makes am_sc_parse_dt() fail its
				 * of_device_is_compatible(node, "amlogic,
				 * isp-sc") test with "Error match compatible".
				 * Only phy-csi below links to &adapter.
				 */
				link-device = <&isp_sc>;
				status = "okay";

				port {
					isp_ep: endpoint {
						remote-endpoint = <&imx415_ep>;
					};
				};
			};

			/* Scaler block, verbatim from mesong12b.dtsi. Parsed by
			 * system_am_sc.c via the isp node's link-device phandle;
			 * it is not a platform driver of its own, so it needs no
			 * compatible match in any module - just the node.
			 */
			isp_sc: isp-sc@ff655400 {
				compatible = "amlogic, isp-sc";
				reg = <0x0 0xff655400 0x0 0x00001000>;
				reg-names = "isp_sc";
				interrupts = <0 17 4>;
				interrupt-names = "isp_sc";
				status = "okay";
			};

			adapter: isp-adapter@ff650000 {
				compatible = "amlogic, isp-adapter";
				reg = <0x0 0xff650000 0x0 0x00006000>;
				reg-names = "adapter";
				interrupts = <0 179 4>;
				interrupt-names = "adapter-irq";
				mem_alloc = <48>;
				status = "okay";
			};

			phycsi: phy-csi@ff650000 {
				compatible = "amlogic, phy-csi";
				reg = <0x0 0xff650000 0x0 0x00002000>,
				      <0x0 0xff652000 0x0 0x00002000>,
				      <0x0 0xff63c300 0x0 0x00000100>,
				      <0x0 0xff654000 0x0 0x00000100>,
				      <0x0 0xff654400 0x0 0x00000100>;
				reg-names = "csi2_phy0", "csi2_phy1", "aphy_reg",
					    "csi0_host", "csi1_host";
				interrupts = <0 41 4>,
					     <0 42 4>,
					     <0 72 4>,
					     <0 74 4>,
					     <0 87 4>,
					     <0 88 4>;
				interrupt-names = "phy0-irq",
						  "phy1-irq",
						  "csi-host0-intr2",
						  "csi-host0-intr1",
						  "csi-host1-intr2",
						  "csi-host1-intr1";
				link-device = <&adapter>;
				status = "okay";
			};
		};
	};

	fragment@2 {
		/* i2c3 = /soc/bus@ffd00000/i2c@1c000, already enabled by
		 * default on this board (meson-g12-i2c-ee-m3-a.dtbo ships
		 * without .disabled) and confirmed the same physical bus as
		 * the CSI connector's CM_I2C_SCL/SDA net - see header comment.
		 */
		target-path = "/soc/bus@ffd00000/i2c@1c000";

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			imx415: camera-sensor@1a {
				compatible = "sony,imx415";
				reg = <0x1a>;

				/*
				 * The sensor's actual INCK is the SoC's
				 * CLK12_24 output on GPIOAO_10, which Linux
				 * does not model as a clock at all (mainline
				 * has neither the clock nor the pinctrl
				 * function) - it is switched on by the
				 * ao_mclk module, not by the clk framework.
				 * imx415.c only ever calls clk_get_rate() on
				 * this, so a fixed-clock stating the true
				 * 24 MHz is both sufficient and honest.
				 *
				 * NOTE: this was previously <&isp_clkc 6>
				 * (gen_clk). That was wrong: gen_clk comes out
				 * on GPIOAO_11, which the schematic shows
				 * going to the *panel* connector, not the
				 * camera - so it could never have clocked the
				 * sensor no matter what it was set to.
				 */
				clocks = <&imx415_inck>;
				clock-names = "inck";

				dvdd-supply = <&imx415_dvdd>;
				ovdd-supply = <&imx415_ovdd>;
				avdd-supply = <&imx415_avdd>;

				/*
				 * CM_RST_L = GPIOA_11 (ball G22), from
				 * schematic page 6; GPIOA_11 is pin/line 60 of
				 * the periphs bank (&gpio). Active low, as the
				 * _L suffix implies. Letting imx415.c own this
				 * means the sensor gets a proper reset pulse
				 * at power-on instead of relying on whatever
				 * state the pin powered up in.
				 * 1 == GPIO_ACTIVE_LOW (avoids needing the
				 * dt-bindings header at overlay build time).
				 */
				reset-gpios = <&gpio 60 1>;

				port {
					imx415_ep: endpoint {
						remote-endpoint = <&isp_ep>;
						/*
						 * 4 lanes @ 720 MHz link freq (= 1440
						 * Mbps per lane), giving 3864x2192 at
						 * 60.038 fps.
						 *
						 * link-frequencies is the DDR *clock*,
						 * i.e. half the lane rate: 1440/2 = 720
						 * MHz. It is unchanged from the 2-lane
						 * configuration - the per-lane rate is
						 * identical, there are simply twice as
						 * many lanes.
						 *
						 * WHY 4 LANES IS REACHABLE
						 * ------------------------
						 * An earlier version of this comment
						 * claimed 4-lane was out of reach,
						 * because imx415.c's only 4-lane mode
						 * (891 Mbps) needs a 27 MHz INCK while
						 * this board's MCLK is 24 MHz. That
						 * conflated two independent things.
						 *
						 * imx415_parse_hw_config() validates the
						 * DT in two separate steps:
						 *
						 *  a) imx415_check_inck() looks up
						 *     imx415_clk_params[] by
						 *     (lane_rate, inck). Lane count is
						 *     NOT part of that key - the
						 *     PLL/INCK block does not care how
						 *     many lanes the serialiser drives.
						 *  b) supported_modes[] is then matched
						 *     on (lanes, lane_rate) to pick the
						 *     mode register list.
						 *
						 * So a 4-lane mode at an already-
						 * supported lane rate needs no new INCK
						 * settings at all, only a register list.
						 * The 1440 Mbps @ 24 MHz entry in
						 * imx415_clk_params[] is already present
						 * and is proven working on this board at
						 * 2 lanes. imx415_mode_4_1440[], added
						 * by this port (see imx415/imx415.c),
						 * supplies the register list. Reachable
						 * triples are now:
						 *
						 *   lane_rate  inck   lanes
						 *    720 MHz   24MHz    2
						 *   1440 MHz   24MHz    2
						 *    891 MHz   27MHz    4  (unreachable)
						 *   1440 MHz   24MHz    4  <- selected
						 *
						 * The 891/27 MHz row remains out of
						 * reach and remains irrelevant: it was
						 * never the only way to get four lanes.
						 *
						 * The connector wires all four data
						 * lanes D0..D3 straight to the A311D's
						 * CSI PHY (see the header comment), so
						 * this is a pure software change at both
						 * ends. Total sensor output bandwidth
						 * goes 2880 -> 5760 Mbps.
						 *
						 * !! COUNTERPART REQUIRED IN isp-module !!
						 * The CSI-2 receiver is not configured
						 * from this endpoint.
						 * isp-module/src/driver/sensor/V4L2_drv.c
						 * hardcodes
						 *     #define IMX415_LANES 2
						 * and passes it to am_mipi_init(). It
						 * must become 4 in lockstep with this
						 * property, or the PHY will listen on
						 * two lanes while the sensor transmits
						 * on four. IMX415_HMAX (4510) is
						 * unchanged; IMX415_FPS_Q8 becomes
						 * ( 60 * 256 ).
						 *
						 * The 2-lane hold that used to be
						 * documented here has been lifted: the
						 * mid-frame stall was the ISP context
						 * sequence never being loaded, not a MIPI
						 * problem, and 2-lane capture is now stable
						 * at 30 fps. Four lanes is the reason this
						 * mode exists for shot-vision:
						 *
						 * ROLLING-SHUTTER SKEW
						 * --------------------
						 * Skew is (active rows) * (line period),
						 * and the line period is HMAX / 72 MHz.
						 * It is NOT the frame period, and adding
						 * vertical blanking does not change it.
						 *
						 *   2 lanes: HMAX 1066 -> 14.806 us
						 *            2192 * 14.806 us = 32.45 ms
						 *   4 lanes: HMAX  533 ->  7.403 us
						 *            2192 *  7.403 us = 16.23 ms
						 *
						 * Halving the line period halves the skew,
						 * which is the whole point: the sensor is
						 * reading continuously (58 blank rows in
						 * 2250, 2.6 %), so there is no idle time to
						 * reclaim and HMAX is the only lever.
						 *
						 * 16.23 ms is the floor for a full-height
						 * readout on this board. HMAX cannot go
						 * below 483 (3864 px * 10 bit / 5760 Mbps =
						 * 6.708 us of payload), and 24 MHz INCK
						 * caps the lane rate at 1440 Mbps, so the
						 * remaining 9 % is not worth the loss of
						 * link margin. Going meaningfully below
						 * 16 ms requires reading fewer ROWS -
						 * 2x2 binning or a vertical window - not a
						 * faster link.
						 *
						 * DECOUPLING FRAME RATE FROM SKEW
						 * -------------------------------
						 * HMAX sets the skew; VMAX sets the frame
						 * rate. V4L2_CID_VBLANK is writable (see
						 * imx415.c) and programs VMAX at runtime,
						 * so if the ISP cannot sustain 60 fps,
						 * raising VBLANK drops the frame rate while
						 * leaving the 16.23 ms readout untouched.
						 * That is still strictly better than the
						 * 2-lane 30 fps path it replaces: same
						 * frame rate, half the skew.
						 */
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <720000000>;
					};
				};
			};
		};
	};

	fragment@3 {
		target-path = "/";

		__overlay__ {
			/* Always-on stand-ins, not real switched rails: the
			 * schematic shows the CSI connector getting fixed
			 * VCC3.3V/VCC5V directly (no software power-gating
			 * GPIO on this connector) - the camera module
			 * presumably regulates its own dvdd/ovdd/avdd
			 * on-module from that. CONFIG_REGULATOR_DUMMY is not
			 * enabled on this kernel (checked
			 * /proc/config.gz), so devm_regulator_bulk_get()
			 * needs *something* to resolve rather than silently
			 * falling back - these exist to satisfy that, not to
			 * model real board power sequencing.
			 */
			/* Stands in for the SoC's CLK12_24 output, which
			 * ao_mclk routes to GPIOAO_10. See the sensor node's
			 * clocks property for why this is a fixed-clock. */
			imx415_inck: clock-imx415-inck {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <24000000>;
				clock-output-names = "imx415_inck";
			};

			imx415_dvdd: regulator-imx415-dvdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415_dvdd";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
			};

			imx415_ovdd: regulator-imx415-ovdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415_ovdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			imx415_avdd: regulator-imx415-avdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415_avdd";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <2900000>;
				regulator-always-on;
			};
		};
	};
};
