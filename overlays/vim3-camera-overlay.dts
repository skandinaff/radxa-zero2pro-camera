/dts-v1/;
/plugin/;

/*
 * Khadas VIM3 / A311D (G12B) IMX415 runtime overlay.
 *
 * Hardware register regions, interrupts, link-device relationships and clock
 * consumer order are transcribed from the read-only Khadas
 * khadas-vims-5.15.y tree:
 *   arch/arm64/boot/dts/amlogic/mesong12b.dtsi
 * VIM3 Camera0 routing is adapted from:
 *   arch/arm64/boot/dts/amlogic/kvim3.dts
 *
 * This does not touch /boot. It is applied only by scripts/load.sh after the
 * matching modules have been built, and removed with scripts/unload.sh.
 *
 * Board adaptation, verified against the running Armbian DTB:
 * - Camera0 control bus is the AO I2C controller, /soc/bus@ff800000/i2c@5000.
 *   Confirmed twice: the base DTB puts the TCA6408 expander and the Khadas MCU
 *   there, and the vendor tree attaches its camera sensor node to &i2c_AO.
 * - reset-gpios = <&gpio_expander 3> matches the vendor kvim3.dts exactly, and
 *   &gpio_expander resolves to the "ti,tca6408" at reg 0x20 in the live DTB.
 * - The vendor also drives pwdn=<gpio_expander 2 active-high>. The mainline
 *   IMX415 binding has no pwdn property, so that line is NOT handled here; it
 *   must be asserted out-of-band before probing a module that needs it.
 *
 * Remaining unknown — must be settled on hardware, not by guessing:
 * - reg = <0x1a> is the IMX415 default 7-bit address (SLASEL low; 0x1b when
 *   high). It has NOT been observed on this board yet. Note that the vendor
 *   tree's "sensor-i2c@6c" is NOT evidence for this: it is the ARM ISP
 *   framework's 8-bit-addressed proxy node for an os08a10, a different sensor.
 *   Confirm with `i2cdetect -y -r 0` before trusting this value.
 * - The three *-supply nodes are fixed always-on placeholders. The VIM3 camera
 *   connector does not expose all bare-sensor rails, so the real module is
 *   assumed to regulate onboard. This models "already powered"; it does not
 *   claim to describe the board's regulator topology.
 *
 * - 24 MHz INCK is generated by ao_mclk.ko on GPIOAO_10; it is modelled here
 *   by a fixed clock because mainline does not expose CLK12_24.
 */

/ {
	fragment@0 {
		target-path = "/soc/bus@ff600000/bus@3c000/system-controller@0";

		__overlay__ {
			isp_clkc: isp-clkc {
				compatible = "khadas,vim3-isp-clkc";
				#clock-cells = <1>;
				status = "okay";
			};
		};
	};

	fragment@1 {
		target-path = "/";

		__overlay__ {
			#address-cells = <2>;
			#size-cells = <2>;
			interrupt-parent = <&gic>;

			isp: isp@ff140000 {
				compatible = "arm, isp";
				reg = <0x0 0xff140000 0x0 0x00040000>;
				reg-names = "ISP";
				isp-efuse = <0xff630038 0x4000>;
				interrupts = <0 142 4>;
				interrupt-names = "ISP";
				temper-buf-size = <24>;
				clocks = <&isp_clkc 0>, <&isp_clkc 1>;
				clock-names = "cts_mipi_isp_clk",
					      "cts_mipi_csi_phy_clk0";
				link-device = <&isp_sc>;
				status = "okay";

				port {
					isp_ep: endpoint {
						remote-endpoint = <&imx415_ep>;
					};
				};
			};

			isp_sc: isp-sc@ff655400 {
				compatible = "amlogic,isp-sc";
				reg = <0x0 0xff655400 0x0 0x00001000>;
				reg-names = "isp_sc";
				interrupts = <0 17 4>;
				interrupt-names = "isp_sc";
				status = "okay";
			};

			adapter: isp-adapter@ff650000 {
				compatible = "amlogic, isp-adapter";
				reg = <0x0 0xff650000 0x0 0x00006000>;
				reg-names = "adapter";
				interrupts = <0 179 4>;
				interrupt-names = "adapter-irq";
				mem_alloc = <48>;
				status = "okay";
			};

			phycsi: phy-csi@ff650000 {
				compatible = "amlogic, phy-csi";
				reg = <0x0 0xff650000 0x0 0x00002000>,
				      <0x0 0xff652000 0x0 0x00002000>,
				      <0x0 0xff63c300 0x0 0x00000100>,
				      <0x0 0xff654000 0x0 0x00000100>,
				      <0x0 0xff654400 0x0 0x00000100>;
				reg-names = "csi2_phy0", "csi2_phy1", "aphy_reg",
					    "csi0_host", "csi1_host";
				interrupts = <0 41 4>, <0 42 4>, <0 72 4>,
					     <0 74 4>, <0 87 4>, <0 88 4>;
				interrupt-names = "phy0-irq", "phy1-irq",
						  "csi-host0-intr2", "csi-host0-intr1",
						  "csi-host1-intr2", "csi-host1-intr1";
				link-device = <&adapter>;
				status = "okay";
			};
		};
	};

	fragment@2 {
		target-path = "/soc/bus@ff800000/i2c@5000";

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			imx415: camera-sensor@1a {
				compatible = "sony,imx415";
				reg = <0x1a>;
				clocks = <&imx415_inck>;
				clock-names = "inck";
				reset-gpios = <&gpio_expander 3 0>;
				dvdd-supply = <&imx415_dvdd>;
				ovdd-supply = <&imx415_ovdd>;
				avdd-supply = <&imx415_avdd>;

				port {
					imx415_ep: endpoint {
						remote-endpoint = <&isp_ep>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <720000000>;
					};
				};
			};
		};
	};

	fragment@3 {
		target-path = "/";

		__overlay__ {
			imx415_inck: imx415-inck {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <24000000>;
			};

			/* Camera-module regulators are not software-switched by VIM3. */
			imx415_dvdd: imx415-dvdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415-dvdd";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			imx415_ovdd: imx415-ovdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415-ovdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			imx415_avdd: imx415-avdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415-avdd";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <2900000>;
				regulator-always-on;
			};
		};
	};
};
