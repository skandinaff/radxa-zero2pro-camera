/dts-v1/;
/plugin/;

/*
 * Khadas VIM3 / A311D (G12B) IMX415 runtime overlay.
 *
 * Hardware register regions, interrupts, link-device relationships and clock
 * consumer order are transcribed from the read-only Khadas
 * khadas-vims-5.15.y tree:
 *   arch/arm64/boot/dts/amlogic/mesong12b.dtsi
 * VIM3 Camera0 routing is adapted from:
 *   arch/arm64/boot/dts/amlogic/kvim3.dts
 *
 * This does not touch /boot. It is applied only by scripts/load.sh after the
 * matching modules have been built, and removed with scripts/unload.sh.
 *
 * Board adaptation, verified against the running Armbian DTB:
 * - Camera0 control bus is the AO I2C controller, /soc/bus@ff800000/i2c@5000.
 *   Confirmed twice: the base DTB puts the TCA6408 expander and the Khadas MCU
 *   there, and the vendor tree attaches its camera sensor node to &i2c_AO.
 * - &gpio_expander resolves to the "ti,tca6408" at reg 0x20 in the live DTB;
 *   line 5 drives the red status LED there exactly as kvim3.dts says, which
 *   confirms the line numbering matches the vendor tree.
 * - Reset is expander line 2, NOT line 3.  kvim3.dts assigns the generic
 *   reset to line 3, but the vendor's own IMX415 driver overrides it:
 *     // IMX415 PIN21 RESET, defined in dts as 'ircut-gpios'
 *     gpio->rst_gpio = gpio->ircut_gpio;
 *   and kvim3.dts has ir_cut_gpio = <&gpio_expander 2>.  IMX415 pin 21 is
 *   XCLR, so on this module XCLR is wired to expander line 2.
 * - Polarity is active-LOW.  XCLR low holds the sensor in reset; the vendor
 *   drives the pad to 1 to run.  Mainline requests the line GPIOD_OUT_HIGH
 *   (asserted) and calls gpiod_set_value(reset, 0) to release, so logical-1
 *   must map to physical LOW -- i.e. GPIO_ACTIVE_LOW.
 *
 * - reg = <0x1a> is the IMX415 default 7-bit address (SLASEL low) and has been
 *   CONFIRMED on this board: with INCK running and XCLR released it answers at
 *   0x1a on i2c-0, and the driver reports "Detected IMX415 image sensor".
 *   Note the vendor tree's "sensor-i2c@6c" is NOT evidence about this address:
 *   it is the ARM ISP framework's 8-bit-addressed proxy node for an os08a10, a
 *   different sensor.
 * - 24 MHz INCK comes from the SoC's gen_clk, consumed here as a normal clock
 *   (isp_clkc output 6). isp_clkc also routes it to CAM_MCLK on GPIOAO_11.
 *
 * Still approximate, and deliberately so:
 * - The three *-supply nodes are fixed always-on placeholders. The VIM3 camera
 *   connector feeds the module from VDDIO_AO18 / VCC3.3V with no enable GPIO
 *   (vim3-sch-v15.pdf), so the module regulates onboard. This models "already
 *   powered"; it does not claim to describe the board's regulator topology.
 */

/ {
	fragment@0 {
		target-path = "/soc/bus@ff600000/bus@3c000/system-controller@0";

		__overlay__ {
			isp_clkc: isp-clkc {
				compatible = "khadas,vim3-isp-clkc";
				#clock-cells = <1>;
				/*
				 * VIM3 CAM_MCLK is GPIOAO_11 / GEN_CLK_EE
				 * (mux 4) per vim3-sch-v15.pdf. Mainline has
				 * no pinctrl group for it, so the clock
				 * provider routes its own output.
				 */
				birdcher,gen-clk-pad = <11 4>;
				status = "okay";
			};
		};
	};

	fragment@1 {
		target-path = "/";

		__overlay__ {
			#address-cells = <2>;
			#size-cells = <2>;
			interrupt-parent = <&gic>;

			isp: isp@ff140000 {
				compatible = "arm, isp";
				reg = <0x0 0xff140000 0x0 0x00040000>;
				reg-names = "ISP";
				isp-efuse = <0xff630038 0x4000>;
				interrupts = <0 142 4>;
				interrupt-names = "ISP";
				temper-buf-size = <24>;
				clocks = <&isp_clkc 0>, <&isp_clkc 1>;
				clock-names = "cts_mipi_isp_clk",
					      "cts_mipi_csi_phy_clk0";
				link-device = <&isp_sc>;
				status = "okay";

				port {
					isp_ep: endpoint {
						remote-endpoint = <&imx415_ep>;
					};
				};
			};

			isp_sc: isp-sc@ff655400 {
				compatible = "amlogic,isp-sc";
				reg = <0x0 0xff655400 0x0 0x00001000>;
				reg-names = "isp_sc";
				interrupts = <0 17 4>;
				interrupt-names = "isp_sc";
				status = "okay";
			};

			adapter: isp-adapter@ff650000 {
				compatible = "amlogic, isp-adapter";
				reg = <0x0 0xff650000 0x0 0x00006000>;
				reg-names = "adapter";
				interrupts = <0 179 4>;
				interrupt-names = "adapter-irq";
				mem_alloc = <48>;
				status = "okay";
			};

			phycsi: phy-csi@ff650000 {
				compatible = "amlogic, phy-csi";
				reg = <0x0 0xff650000 0x0 0x00002000>,
				      <0x0 0xff652000 0x0 0x00002000>,
				      <0x0 0xff63c300 0x0 0x00000100>,
				      <0x0 0xff654000 0x0 0x00000100>,
				      <0x0 0xff654400 0x0 0x00000100>;
				reg-names = "csi2_phy0", "csi2_phy1", "aphy_reg",
					    "csi0_host", "csi1_host";
				interrupts = <0 41 4>, <0 42 4>, <0 72 4>,
					     <0 74 4>, <0 87 4>, <0 88 4>;
				interrupt-names = "phy0-irq", "phy1-irq",
						  "csi-host0-intr2", "csi-host0-intr1",
						  "csi-host1-intr2", "csi-host1-intr1";
				link-device = <&adapter>;
				status = "okay";
			};
		};
	};

	fragment@2 {
		target-path = "/soc/bus@ff800000/i2c@5000";

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			imx415: camera-sensor@1a {
				compatible = "sony,imx415";
				reg = <0x1a>;
				/*
				 * Real CCF consumer of gen_clk (isp_clkc
				 * output 6), not a fixed-clock stand-in: this
				 * makes the sensor's clk_prepare_enable()
				 * actually gate the hardware on, makes
				 * clk_get_rate() report the true INCK the
				 * driver keys its register tables off, and
				 * makes probe order fall out of the normal
				 * deferred-probe dependency instead of a
				 * module load-order rule.
				 */
				clocks = <&isp_clkc 6>;
				clock-names = "inck";
				/*
				 * No assigned-clock-parents here: the only
				 * gen_clk output exposed to DT is the final
				 * gate, whose sole parent is gen_clk_div, so
				 * asking to reparent it to &xtal is rejected
				 * with -EINVAL.  isp_clkc selects the xtal
				 * source itself -- see its gen_clk pad setup.
				 */
				assigned-clocks = <&isp_clkc 6>;
				assigned-clock-rates = <24000000>;
				/*
				 * Expander line 2, active-LOW.  See the header
				 * comment: the vendor IMX415 driver remaps reset
				 * onto the ircut line (expander 2), and XCLR is
				 * active-low, so mainline's "de-assert" must
				 * drive the pad HIGH.
				 */
				reset-gpios = <&gpio_expander 2 1>;
				dvdd-supply = <&imx415_dvdd>;
				ovdd-supply = <&imx415_ovdd>;
				avdd-supply = <&imx415_avdd>;

				port {
					imx415_ep: endpoint {
						remote-endpoint = <&isp_ep>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <720000000>;
					};
				};
			};
		};
	};

	fragment@3 {
		target-path = "/";

		__overlay__ {
			/* Camera-module regulators are not software-switched by VIM3. */
			imx415_dvdd: imx415-dvdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415-dvdd";
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-always-on;
			};

			imx415_ovdd: imx415-ovdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415-ovdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			imx415_avdd: imx415-avdd {
				compatible = "regulator-fixed";
				regulator-name = "imx415-avdd";
				regulator-min-microvolt = <2900000>;
				regulator-max-microvolt = <2900000>;
				regulator-always-on;
			};
		};
	};
};
